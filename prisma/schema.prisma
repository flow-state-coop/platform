datasource db {
  provider = "postgresql"
}

generator kysely {
  provider     = "prisma-kysely"
  output       = "../src/generated"
  fileName     = "kysely.ts"
  camelCase    = true
}

enum ApplicationStatus {
  INCOMPLETE
  SUBMITTED
  ACCEPTED
  CHANGES_REQUESTED
  REJECTED
  REMOVED
  GRADUATED
}

enum ChannelType {
  INTERNAL_APPLICATION
  GROUP_ANNOUNCEMENTS
  GROUP_APPLICANTS
  GROUP_GRANTEES
  GROUP_ROUND_ADMINS
  GROUP_PROJECT
  PUBLIC_ROUND
  PUBLIC_PROJECT
}

model Round {
  id                       Int           @id @default(autoincrement())
  chainId                  Int           @map("chain_id")
  flowCouncilAddress       String        @map("flow_council_address") @db.VarChar(42)
  superappSplitterAddress  String?       @map("superapp_splitter_address") @db.VarChar(42)
  applicationsClosed       Boolean       @default(false) @map("applications_closed")
  details                  Json?
  lastClaimAt              DateTime?     @map("last_claim_at")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at")
  admins                   RoundAdmin[]
  applications             Application[]
  messages                 Message[]
  voterGroups              VoterGroup[]
  voterGroupMembers        VoterGroupMember[]
  metricsApiKeys           MetricsApiKey[]

  @@unique([chainId, flowCouncilAddress])
  @@map("rounds")
}

model RoundAdmin {
  id           Int               @id @default(autoincrement())
  roundId      Int               @map("round_id")
  adminAddress String            @map("admin_address") @db.VarChar(42)
  createdAt    DateTime          @default(now()) @map("created_at")
  round        Round             @relation(fields: [roundId], references: [id])
  emails       RoundAdminEmail[]

  @@unique([roundId, adminAddress])
  @@map("round_admins")
}

model RoundAdminEmail {
  id           Int        @id @default(autoincrement())
  roundAdminId Int        @map("round_admin_id")
  email        String     @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  roundAdmin   RoundAdmin @relation(fields: [roundAdminId], references: [id])

  @@unique([roundAdminId, email])
  @@map("round_admin_emails")
}

model VoterGroup {
  id                 Int                @id @default(autoincrement())
  roundId            Int                @map("round_id")
  name               String             @db.VarChar(100)
  eligibilityMethod  String             @map("eligibility_method") @db.VarChar(50)
  defaultVotingPower Int                @default(10) @map("default_voting_power")
  lastBallotAt       DateTime?          @map("last_ballot_at")
  nftContractAddress String?            @map("nft_contract_address") @db.VarChar(42)
  nftTokenStandard   String?            @map("nft_token_standard") @db.VarChar(10)
  nftTokenId         String?            @map("nft_token_id") @db.VarChar(78)
  nftAcquisitionUrl  String?            @map("nft_acquisition_url")
  nftCollectionName  String?            @map("nft_collection_name") @db.VarChar(100)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  round              Round              @relation(fields: [roundId], references: [id])
  members            VoterGroupMember[]
  apiKeys            MetricsApiKey[]

  @@unique([roundId, name])
  @@map("voter_groups")
  // Also has two partial unique indexes, defined in raw SQL because Prisma can't
  // model partial indexes — keep them in their migrations, do not let
  // `migrate dev` drop them:
  //   `voter_groups_round_metrics_unique` (round_id WHERE eligibility_method =
  //     'metrics'), in 20260617000000_add_metrics_voter.
  //   `voter_groups_round_nft_unique` (round_id, lower(nft_contract_address),
  //     coalesce(nft_token_id, '') WHERE eligibility_method = 'nft'), in
  //     20260721000000_add_nft_voter_group.
}

model MetricsApiKey {
  id            Int        @id @default(autoincrement())
  roundId       Int        @map("round_id")
  voterGroupId  Int        @map("voter_group_id")
  keyHash       String     @unique @map("key_hash") @db.VarChar(64)
  keyPrefix     String     @map("key_prefix") @db.VarChar(16)
  label         String     @db.VarChar(100)
  lastUsedAt    DateTime?  @map("last_used_at")
  cooldownUntil DateTime?  @map("cooldown_until")
  revokedAt     DateTime?  @map("revoked_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  round         Round      @relation(fields: [roundId], references: [id])
  voterGroup    VoterGroup @relation(fields: [voterGroupId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([voterGroupId])
  @@map("metrics_api_keys")
}

// Serializes transactions signed by the shared Flow State bot key, one row per
// chain. `holder`/`expires_at` are the lease; `last_nonce` is a durable ledger
// of the last nonce this platform broadcast, so the sender never depends on a
// load-balanced RPC's pending view (two nodes can disagree, handing the same
// nonce to two sends). Rows are created on demand by the first send on a chain.
model BotChainLock {
  chainId     Int       @id @map("chain_id")
  holder      String?   @db.VarChar(64)
  acquiredAt  DateTime? @map("acquired_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  lastNonce   BigInt?   @map("last_nonce")
  lastNonceAt DateTime? @map("last_nonce_at") @db.Timestamptz(6)

  @@map("bot_chain_locks")
}

model VoterGroupMember {
  id           Int        @id @default(autoincrement())
  voterGroupId Int        @map("voter_group_id")
  roundId      Int        @map("round_id")
  address      String     @db.VarChar(42)
  createdAt    DateTime   @default(now()) @map("created_at")
  voterGroup   VoterGroup @relation(fields: [voterGroupId], references: [id])
  round        Round      @relation(fields: [roundId], references: [id])

  @@unique([roundId, address])
  @@map("voter_group_members")
}

// Flow Splitter API storage. Keyed on (chain_id, pool_id) with no FK into the
// council tables: splitters have no round, and coupling them would let a
// council-side delete cascade into an unrelated pool's integration.
// `pool_id` is the uint256 pool id as text, following the nft_token_id
// precedent above and avoiding numeric coercion surprises in Kysely.
model SplitterApiKey {
  id            Int       @id @default(autoincrement())
  chainId       Int       @map("chain_id")
  poolId        String    @map("pool_id") @db.VarChar(78)
  keyHash       String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix     String    @map("key_prefix") @db.VarChar(16)
  label         String    @db.VarChar(100)
  createdBy     String?   @map("created_by") @db.VarChar(42)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  cooldownUntil DateTime? @map("cooldown_until") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([chainId, poolId])
  @@map("splitter_api_keys")
}

// One row per API-controlled pool. Doubles as the rate-limit claim row, so it
// is created on demand rather than depending on key-mint lifecycle.
model SplitterIntegration {
  chainId     Int       @map("chain_id")
  poolId      String    @map("pool_id") @db.VarChar(78)
  lastWriteAt DateTime? @map("last_write_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([chainId, poolId])
  @@map("splitter_integrations")
}

// `heartbeat_at` is NOT NULL DEFAULT now() on purpose: the in-flight check that
// stops a second write being accepted reads it directly, and a null on a
// freshly queued row would read as "not running" and let two runners onto one
// pool. Jobs expire (their target register is worthless once finished) while
// history rows do not.
model SplitterWriteJob {
  id          String   @id @db.VarChar(36)
  chainId     Int      @map("chain_id")
  poolId      String   @map("pool_id") @db.VarChar(78)
  keyId       Int      @map("key_id")
  payloadHash String   @map("payload_hash") @db.VarChar(64)
  status      String   @db.VarChar(20)
  target      Json
  batchIndex  Int      @default(0) @map("batch_index")
  txHashes    String[] @default([]) @map("tx_hashes")
  changedCount Int     @default(0) @map("changed_count")
  gasUsed     String   @default("0") @map("gas_used") @db.VarChar(78)
  gasCostWei  String   @default("0") @map("gas_cost_wei") @db.VarChar(78)
  attempt     Int      @default(0)
  heartbeatAt DateTime @default(now()) @map("heartbeat_at") @db.Timestamptz(6)
  error       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([chainId, poolId, status])
  @@index([heartbeatAt])
  @@map("splitter_write_jobs")
}

// The register the platform last wrote, per pool. A candidate-address list
// only: units always come from the chain, so a human edit between API writes is
// corrected by the next write rather than overwritten from stale data. Without
// it a recipient added by one write and dropped by the next, before the indexer
// caught up, would appear in neither source and keep receiving flow forever.
model SplitterWrittenRegister {
  chainId   Int      @map("chain_id")
  poolId    String   @map("pool_id") @db.VarChar(78)
  address   String   @db.VarChar(42)
  units     String   @db.VarChar(78)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([chainId, poolId, address])
  @@map("splitter_written_register")
}

// Kept indefinitely: it is what explains a register months later, and a row is
// small. Cost is recorded per key as well as per pool, because the key is known
// at write time and cannot be reconstructed later.
model SplitterWriteHistory {
  id           Int      @id @default(autoincrement())
  chainId      Int      @map("chain_id")
  poolId       String   @map("pool_id") @db.VarChar(78)
  keyId        Int?     @map("key_id")
  jobId        String?  @map("job_id") @db.VarChar(36)
  changedCount Int      @map("changed_count")
  status       String   @db.VarChar(20)
  txHashes     String[] @default([]) @map("tx_hashes")
  gasUsed      String?  @map("gas_used") @db.VarChar(78)
  gasCostWei   String?  @map("gas_cost_wei") @db.VarChar(78)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([chainId, poolId, createdAt])
  @@index([keyId])
  @@map("splitter_write_history")
}

model Project {
  id           Int              @id @default(autoincrement())
  details      Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")
  applications Application[]
  emails       ProjectEmail[]
  managers     ProjectManager[]
  messages     Message[]

  @@map("projects")
}

model ProjectEmail {
  id             Int      @id @default(autoincrement())
  projectId      Int      @map("project_id")
  email          String   @db.VarChar(255)
  managerAddress String?  @map("manager_address") @db.VarChar(42)
  createdAt      DateTime @default(now()) @map("created_at")
  project        Project  @relation(fields: [projectId], references: [id])

  @@unique([projectId, email])
  @@map("project_emails")
}

model Application {
  id                 Int                  @id @default(autoincrement())
  projectId          Int                  @map("project_id")
  roundId            Int                  @map("round_id")
  fundingAddress     String               @map("funding_address") @db.VarChar(42)
  status             ApplicationStatus    @default(SUBMITTED)
  details            Json?
  project            Project              @relation(fields: [projectId], references: [id])
  round              Round                @relation(fields: [roundId], references: [id])
  editsUnlocked      Boolean              @default(false) @map("edits_unlocked")
  recipient          Recipient?
  messages           Message[]
  milestoneProgress  MilestoneProgress[]
  inboxItems         InboxItem[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at")

  @@unique([projectId, roundId])
  @@index([roundId], name: "idx_applications_round")
  @@map("applications")
}

model Recipient {
  id            Int         @id @default(autoincrement())
  applicationId Int         @unique @map("application_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  application   Application @relation(fields: [applicationId], references: [id])

  @@map("recipients")
}

model MilestoneProgress {
  id              Int         @id @default(autoincrement())
  applicationId   Int         @map("application_id")
  milestoneType   String      @map("milestone_type") @db.VarChar(100)
  milestoneIndex  Int         @map("milestone_index")
  progress        Json?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")
  application     Application @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, milestoneType, milestoneIndex])
  @@map("milestone_progress")
}

model ProjectManager {
  id             Int      @id @default(autoincrement())
  projectId      Int      @map("project_id")
  managerAddress String   @map("manager_address") @db.VarChar(42)
  createdAt      DateTime @default(now()) @map("created_at")
  project        Project  @relation(fields: [projectId], references: [id])

  @@unique([projectId, managerAddress])
  @@map("project_managers")
}

model Message {
  id            Int                @id @default(autoincrement())
  channelType   ChannelType        @map("channel_type")
  roundId       Int?               @map("round_id")
  projectId     Int?               @map("project_id")
  applicationId Int?               @map("application_id")
  authorAddress String             @map("author_address") @db.VarChar(42)
  content       String
  messageType   String             @default("user") @map("message_type") @db.VarChar(20)
  pinnedAt      DateTime?          @map("pinned_at")
  pinnedBy      String?            @map("pinned_by") @db.VarChar(42)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at")
  round         Round?             @relation(fields: [roundId], references: [id])
  project       Project?           @relation(fields: [projectId], references: [id])
  application   Application?       @relation(fields: [applicationId], references: [id])
  reactions     MessageReaction[]
  inboxItems    InboxItem[]

  @@index([channelType, roundId, createdAt], name: "idx_messages_round_feed")
  @@index([channelType, projectId, createdAt], name: "idx_messages_project_feed")
  @@index([channelType, applicationId, createdAt], name: "idx_messages_application_feed")
  @@map("messages")
}

model MessageReaction {
  id            Int      @id @default(autoincrement())
  messageId     Int      @map("message_id")
  authorAddress String   @map("author_address") @db.VarChar(42)
  emoji         String   @db.VarChar(8)
  createdAt     DateTime @default(now()) @map("created_at")
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, authorAddress, emoji])
  @@map("message_reactions")
}

model UserProfile {
  id                            Int       @id @default(autoincrement())
  address                       String    @unique @db.VarChar(42)
  displayName                   String    @map("display_name") @db.VarChar(50)
  bio                           String?   @db.VarChar(300)
  twitter                       String?   @db.VarChar(255)
  github                        String?   @db.VarChar(255)
  linkedin                      String?   @db.VarChar(255)
  farcaster                     String?   @db.VarChar(255)
  email                         String?   @db.VarChar(255)
  telegram                      String?   @db.VarChar(255)
  notifyApplicationEligibility  Boolean   @default(true)  @map("notify_application_eligibility")
  notifyProjectChannels         Boolean   @default(true)  @map("notify_project_channels")
  notifyRoundAnnouncements      Boolean   @default(true)  @map("notify_round_announcements")
  notifyInternalReview          Boolean   @default(true)  @map("notify_internal_review")
  notifyPlatform                Boolean   @default(true)  @map("notify_platform")
  consentConfirmedAt            DateTime? @map("consent_confirmed_at")
  consentVersion                String?   @map("consent_version") @db.VarChar(20)
  emailVersion                  Int       @default(0)     @map("email_version")
  emailSuspendedAt              DateTime? @map("email_suspended_at")
  emailSuspensionReason         String?   @map("email_suspension_reason") @db.VarChar(20)
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model InboxItem {
  id               Int          @id @default(autoincrement())
  recipientAddress String       @map("recipient_address") @db.VarChar(42)
  messageId        Int?         @map("message_id")
  applicationId    Int?         @map("application_id")
  category         String       @db.VarChar(50)
  sourceLabel      String?      @map("source_label") @db.VarChar(255)
  snippet          String?      @db.VarChar(500)
  readAt           DateTime?    @map("read_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  message          Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  application      Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([recipientAddress, readAt], name: "idx_inbox_items_recipient_unread")
  @@index([recipientAddress, category, createdAt], name: "idx_inbox_items_recipient_category")
  @@map("inbox_items")
}
