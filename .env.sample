NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_GRAPH_API_KEY=

# Secret for signing email notification preference/unsubscribe tokens (HMAC).
# Required: the notification token module throws if unset.
NOTIFICATION_HMAC_SECRET=

# Bearer secret for the platform-message admin endpoint.
# Required: the route returns 401 if unset.
PLATFORM_MESSAGE_SECRET=

# Secret for hashing metrics API keys (HMAC).
# Required: minting and verifying metrics keys throws if unset.
METRICS_API_KEY_SECRET=

# Private key the Flow State bot signs with (council ballots, NFT claims,
# GoodDollar voter adds). Must derive FLOW_STATE_BOT_ADDRESS, which the on-chain
# role grants point at; a rotation without updating that constant breaks every
# automated path at once.
FLOW_STATE_ELIGIBILITY_PK=

# Optional per-chain RPC override for bot sends, e.g. RPC_URL_8453 for Base.
# Falls back to the network's public endpoint. A service signing real
# transactions should not depend on load-balanced public endpoints, whose gas
# estimation caps also bound how large a batch can be.
# RPC_URL_<chainId>=
